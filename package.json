{
  "name": "dsh-cost",
  "version": "0.1.0",
  "description": "Evidence-first token cost ledger and budget checks for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./ledger": "./lib/ledger.mjs"
  },
  "bin": {
    "dsh-cost": "./bin/dsh-cost.mjs"
  },
  "files": [
    "index.js",
    "lib/",
    "bin/",
    "cordis.patch.yml",
    "prices.example.json",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test test/ledger.test.mjs",
    "check": "node scripts/check.mjs",
    "smoke:plugin": "node test/plugin-smoke.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongsheng123132/dsh-cost.git"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "token-cost",
    "budget"
  ]
}

